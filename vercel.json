{
  "buildCommand": "cd DOE-1/frontend && npm install && npm run build",
  "outputDirectory": "DOE-1/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://designofexperiments.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
